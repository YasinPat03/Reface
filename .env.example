# Clé pour les tests « live » (tests/e2e/live.ts) uniquement.
# Copier vers .env.local (ignoré par git) et remplir. L'extension, elle, utilise la clé saisie dans Options.
BP_API_KEY=
BP_BASE_URL=https://api.openai.com/v1
BP_MODEL=gpt-6-luna

# Optionnel : utiliser le serveur de démonstration local au lieu du catalogue hébergé.
# VITE_REFACE_CATALOGUE_URL=http://127.0.0.1:8892/api/catalogue
